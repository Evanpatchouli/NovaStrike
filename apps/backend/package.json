{
  "name": "@nova-strike/backend",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-bundle/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nova-strike/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.2",
    "pino": "^10.1.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
